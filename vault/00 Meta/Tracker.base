filters:
  and:
    - file.ext == "md"
    - not:
        - file.inFolder("00 Meta")
        - file.inFolder("90 Templates")
        - file.inFolder("99 Attachments")
formulas:
  days_idle: (now() - file.mtime).days.round(0)
properties:
  status:
    displayName: Status
  type:
    displayName: Type
  mode:
    displayName: Mode
  source:
    displayName: Source
  file.folder:
    displayName: Folder
  file.mtime:
    displayName: Touched
  formula.days_idle:
    displayName: Days idle
views:
  - type: kanban
    name: Board
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - type
      - file.folder
      - formula.days_idle
  - type: table
    name: Inbox
    filters:
      or:
        - status == "inbox"
        - file.inFolder("01 Inbox")
    order:
      - file.name
      - file.folder
      - source
      - file.ctime
  - type: table
    name: Doing
    filters: status == "doing"
    order:
      - file.name
      - type
      - file.folder
      - file.mtime
  - type: table
    name: Stale
    filters:
      and:
        - status == "todo"
        - (now() - file.mtime).days >= 21
    order:
      - file.name
      - file.folder
      - formula.days_idle
  - type: table
    name: By area
    filters: file.inFolder("03 Knowledge")
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - type
      - status
      - mode
      - file.mtime
